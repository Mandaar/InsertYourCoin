# ==============================================================================
# .env.deploy -- secrets + parametres du DEPLOIEMENT Docker (reverse proxy,
# authentification, parametres du paper trading).
#
# Copie ce fichier en ".env.deploy" et remplis-le AVANT `docker compose up`.
# NE JAMAIS COMMITER ".env.deploy" (deja dans .gitignore).
#
# Ceci n'est PAS le ".env" applicatif des cles API Kraken -- en Phase 1
# (paper + monitoring), AUCUNE cle Kraken n'est necessaire ni montee dans
# les conteneurs. Voir docs/DEPLOY_DOCKER.md section 8 ("Ajouter le live --
# Lot 8B, superviseur + armement persistant") pour la marche a suivre le
# jour ou tu voudras passer au reel (overlay docker-compose.live.yml, NON
# active par defaut).
# ==============================================================================

# ------------------------------------------------------------------------------
# Acces web (obligatoire) -- choisis UN des deux modes ci-dessous.
# ------------------------------------------------------------------------------

# --- Mode A : tu as un NOM DE DOMAINE qui pointe vers ce serveur ------------
# (DNS deja configure : un enregistrement A/AAAA pointant vers l'IP publique
# de ce serveur Debian, ports 80 ET 443 ouverts sur le pare-feu/routeur)
#   -> certificat HTTPS public Let's Encrypt, obtenu et renouvele automatiquement.
IYC_SITE_ADDRESS=trading.exemple.tld
IYC_TLS_MODE=toi@exemple.tld

# --- Mode B : tu n'as PAS de domaine, tu accedes par IP ---------------------
# (decommente ces 2 lignes et COMMENTE les 2 lignes du Mode A ci-dessus)
#   -> certificat auto-signe (CA interne Caddy), fonctionne immediatement,
#      le navigateur affiche un avertissement a accepter une fois.
# IYC_SITE_ADDRESS=:443
# IYC_TLS_MODE=internal

# ------------------------------------------------------------------------------
# Authentification (obligatoire) -- protege TOUT le dashboard, y compris la
# page Options (configuration des cles API, pas de securite applicative propre).
# ------------------------------------------------------------------------------
IYC_BASIC_AUTH_USER=admin

# Hash BCRYPT du mot de passe (JAMAIS le mot de passe en clair ici). Genere-le
# avec l'image Caddy elle-meme, sur le serveur Debian, avant le premier
# `docker compose up` :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'TON_MOT_DE_PASSE_FORT'
# Colle le resultat (commence par $2a$ ou $2b$) ci-dessous.
IYC_BASIC_AUTH_HASH=

# ------------------------------------------------------------------------------
# Parametres du paper trading (NON sensibles). Valeurs par defaut = la CIBLE
# decidee le 2026-09-24 (cap CLAUDE.md, "Go" de Mandar) : TSMOM 365 seul, deux
# poches BTC + ETH (une variable de symbole par poche, ci-dessous), timeframe
# journalier, ordres limite, sans stop/take-profit/trailing (jamais mesures
# par les etudes -- #5, #10, #11 -- qui valident cette cible). Modifie-les
# uniquement en connaissance de cause : une variable oubliee ou vide retombe
# SILENCIEUSEMENT sur le defaut code dans le compose (meme valeur qu'ici).
# ------------------------------------------------------------------------------
PAPER_STRATEGY=tsmom
# Deux poches, deux variables de symbole (une par service du compose) :
PAPER_SYMBOL=ETH/USD
PAPER_BTC_SYMBOL=BTC/USD
PAPER_TIMEFRAME=1d
# Parametres de la strategie (meme format que --fixed du walk-forward).
# lookback = fenetre en JOURS du momentum (etudes #5/#10/#11 : 365j est le
# seul horizon mesure qui protege les 3 actifs testes -- fragile, seul
# horizon positif du vote a 5 horizons rejete par l'etude #11).
PAPER_PARAMS=lookback=365
# 'market' (taker, frais 0,80%) ou 'limit' (maker, frais 0,40% -- POSTONLY,
# remplissage NON garanti). Cible : limit. IMPORTANT -- le paper en ordres
# limite NE SIMULE NI le non-remplissage NI le glissement de prix
# (trading/paper_trader.py) : il est donc OPTIMISTE sur l'execution reelle,
# qui remplirait moins souvent et parfois a un prix legerement different.
PAPER_ORDER_TYPE=limit
# 0 DESACTIVE chaque reglage (comportement de main.py::_frac + `if
# self.stop_loss:` dans trading/paper_trader.py -- une chaine vide ou absente
# retombe sur cette meme valeur de defaut, 0 y compris). La cible TSMOM
# 365 est mesuree SANS aucun de ces trois reglages (etudes #5/#10/#11) :
# les activer changerait le comportement par rapport a ce qui a ete mesure.
PAPER_STOP_LOSS=0
PAPER_TAKE_PROFIT=0
PAPER_TRAILING_STOP=0

# ------------------------------------------------------------------------------
# Deploiement DERRIERE UN REVERSE-PROXY EXISTANT uniquement (docker-compose.
# eunivers.yml -- SWAG / serveur mutualise). SANS EFFET avec docker-compose.yml
# (mode dedie) : ignore-la si tu utilises le mode dedie avec Caddy.
# ------------------------------------------------------------------------------

# Hote(s) HTTP additionnel(s) acceptes par l'anti DNS-rebinding applicatif
# (trading/monitor.py::host_allowed), en plus de 127.0.0.1/localhost qui
# restent TOUJOURS acceptes. Necessaire car SWAG ne reecrit PAS l'en-tete Host
# (reecrire le Host cote nginx est interdit sur ce serveur -- double
# `proxy_set_header Host` = incident deja vecu) : le Host recu par le
# conteneur `monitor` est donc le domaine public. Liste separee par virgules
# si plusieurs domaines pointent vers ce service.
# IYC_ALLOWED_HOSTS=iyc.eunivers.net
